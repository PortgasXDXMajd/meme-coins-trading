# Required
ANTHROPIC_API_KEY=

# Optional but recommended (both free):
# Jupiter key doubles the quote rate limit - https://developers.jup.ag
JUPITER_API_KEY=
# Helius key gives a faster, more reliable RPC - https://helius.dev
HELIUS_API_KEY=

# paper (default) simulates fills at live Jupiter quotes. live spends real funds.
TRADING_MODE=paper
PAPER_STARTING_USD=250

# Timezone for log and dashboard times when running in Docker
# TZ=Europe/Berlin

# Any setting in src/desk/config.py can be overridden here, for example:
# MOMENTUM_MIN_PRICE_CHANGE_M5_PCT=3    # 5m price change needed to trigger
# MOMENTUM_MAX_PRICE_CHANGE_M5_PCT=40   # above this it is a vertical candle: skip
# MOMENTUM_VOLUME_SURGE_MULTIPLE=2      # 5m volume vs its trailing-hour average
# MOMENTUM_MIN_BUY_SHARE_PCT=55         # share of 5m trades that are buys
# MOMENTUM_MIN_VOLUME_M5_USD=3000
# SCOUT_INTERVAL_SECONDS=20             # how often the watchlist is re-priced
# WATCHLIST_MAX_SIZE=600
# STOP_LOSS_PCT=6                 # tightest stop
# MAX_STOP_LOSS_PCT=12            # widest stop
# STOP_VOLATILITY_MULTIPLE=2.5    # stop = this x average one-minute range
# TAKE_PROFIT_PCT=18
# TAKE_PROFIT_FRACTION=0.5
# MAX_UNREBUTTED_REASONS=1
# TRAIL_ACTIVATION_PCT=12
# TRAIL_DISTANCE_PCT=6
# MAX_POSITION_PCT=8
# MAX_OPEN_POSITIONS=5
# MAX_DEBATES_PER_HOUR=20
# DEBATE_MODEL=claude-opus-5-5
# BEAR_MODEL=claude-sonnet-5-5
